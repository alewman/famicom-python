@@ -437,10 +437,15 @@ private:
 			if(_runIrq && !_prevRunIrq) {
 				_runIrq = false;
 			}
+			//famicom-python patch: the same for an NMI edge seen in the operand cycle
+			//(perfect6502: a taken same-page branch delays NMI as it does IRQ)
+			bool holdNmi = _needNmi && !_prevNeedNmi;
 			DummyRead();
 
 			if(CheckPageCrossed(PC(), offset)) {
