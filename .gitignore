# Fetched references and test programs; scripts/fetch_references.py fills
# these from scripts/pinned_files.json and scripts/pinned_repos.json.
# Never commit them: third-party documents, programs and source trees.
# (no trailing slash: worktrees link these in, and a link is not a directory)
/reference
/tests/test_roms

# MAME oracle runs (scripts/mame_trace.py): traces, error.log, cfg, nvram.
# Never commit ROMs or traces.
tests/mame_traces/
*.trace
error.log

# scripts/count_mappers.py output.
coverage.json

# PPUSim (scripts/build_ppusim.py) dumps its PLA tables into the working directory,
# and its RP2C07-0 its PAL chroma decoder.
[HV]PLA_*.bin
PALChromaDecoder.bin
